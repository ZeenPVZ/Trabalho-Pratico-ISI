      <schema_name/>
    </partitioning>
    <connection>PostgreSQL_qualidade_ar</connection>
    <sql>SELECT
    BTRIM(m.local) AS local,
    m.data_hora,
    CAST(m.data_hora AS DATE) AS data,
    m.temperatura,
    m.humidade,
    a.pm10,
    a.pm2_5,
    a.no2,
    a.o3
FROM public.stg_meteo AS m
LEFT JOIN public.stg_qualidade_ar AS a
    ON BTRIM(a.local) = BTRIM(m.local)
   AND a.data_hora = m.data_hora
ORDER BY
    BTRIM(m.local),
    CAST(m.data_hora AS DATE),
    m.data_hora;</sql>
    <limit>0</limit>
    <lookup/>
